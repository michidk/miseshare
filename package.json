{
  "name": "miseshare",
  "version": "0.1.0",
  "description": "A tiny, open-source, peer-to-peer screen sharing service.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michidk/miseshare.git"
  },
  "bugs": {
    "url": "https://github.com/michidk/miseshare/issues"
  },
  "homepage": "https://miseshare.vercel.app",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": "1.4.0"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "start": "bun .output/server/index.mjs",
    "preview": "vite preview",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:down": "docker compose down",
    "db:migrate": "bun run scripts/migrate.ts",
    "db:up": "docker compose up -d --wait database",
    "check": "biome check . && bun run check:boundaries",
    "check:boundaries": "bun run scripts/check-import-boundaries.ts",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "lint:deadcode": "knip",
    "pretest": "bun run build && bun run db:migrate",
    "test": "bun test test/*.test.ts",
    "pretest:e2e": "bun run build && bun run db:migrate",
    "test:e2e": "playwright test",
    "test:unit": "bun test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "verify": "bun run check && bun run typecheck && bun run test && bun run db:check && bun run lint:deadcode && bun run build",
    "verify:fast": "bun run check && bun run typecheck && bun run test:unit && bun run lint:deadcode && bun run build",
    "verify:full": "bun run verify && bun run test:e2e",
    "vercel-build": "bun run scripts/vercel-build.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@mkody/twitch-emoticons": "^2.9.9",
    "@msgpack/msgpack": "^3.1.3",
    "@tanstack/react-router": "^1.170.16",
    "@tanstack/react-start": "1.168.54",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "h3": "2.0.1-rc.22",
    "pg": "^8.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/router-cli": "^1.167.17",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.0.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.10",
    "knip": "^6.16.1",
    "nitro": "^3.0.260610-beta",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  }
}
