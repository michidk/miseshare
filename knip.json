{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/routes/**/*.tsx",
    "src/router.tsx",
    "src/server.ts",
    "src/start.ts",
    "src/lib/server/*-handler.server.ts",
    "test/**/*.test.ts",
    "e2e/**/*.ts",
    "scripts/**/*.ts"
  ],
  "project": ["src/**/*.{ts,tsx,css}", "test/**/*.ts", "e2e/**/*.ts", "scripts/**/*.ts", "*.config.ts"],
  "ignoreExportsUsedInFile": true
}
